# Foclyra Environment Variables

# 1. Google Cloud YouTube API Key (Server Secret)
# Used exclusively by the serverless proxy /api/youtube.
# In Vercel, set as 'YOUTUBE_API_KEY' with Type: Secret.
# Never exposed in client browser JavaScript.
YOUTUBE_API_KEY=your_google_cloud_youtube_api_key_here

# 2. Supabase Authentication & Database (Client Public Credentials)
# These MUST start with VITE_ so the React client in the browser can connect to Supabase.
# Safe in browser: data access is secured by PostgreSQL Row-Level Security (RLS) policies.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
