# Foclyra Local Environment Secrets
# Copy this file to .env and replace with your actual keys.
# .env is excluded from git version control in .gitignore.

# Google Cloud Console YouTube Data API v3 Key
VITE_YOUTUBE_API_KEY=your_google_cloud_youtube_api_key_here

# Supabase Authentication & Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
